name: Android + Native C++ CI

on:
  workflow_dispatch:

  push:
    branches: ["main"]
    paths:
      - "**/CMakeLists.txt"
      - "**/*.cmake"
      - "**/*.cpp"
      - "**/*.cxx"
      - "**/*.cc"
      - "**/*.c"
      - "**/*.h"
      - "**/*.hpp"
      - "**/*.kt"
      - "**/*.java"
      - "**/*.gradle"
      - "**/*.gradle.kts"
      - "**/gradle.properties"
      - "**/AndroidManifest.xml"

  pull_request:
    branches: ["main"]
    paths:
      - "**/CMakeLists.txt"
      - "**/*.cmake"
      - "**/*.cpp"
      - "**/*.cxx"
      - "**/*.cc"
      - "**/*.c"
      - "**/*.h"
      - "**/*.hpp"
      - "**/*.kt"
      - "**/*.java"
      - "**/*.gradle"
      - "**/*.gradle.kts"
      - "**/gradle.properties"
      - "**/AndroidManifest.xml"

  schedule:
    - cron: "32 16 * * 5"

env:
  BUILD_DIR: ${{ github.workspace }}/build
  JAVA_VERSION: "17"
  ANDROID_API_LEVEL: "35"
  ANDROID_BUILD_TOOLS: "35.0.0"
  NDK_VERSION: "27.2.12479018"

permissions:
  contents: read

jobs:

  # ------------------------------------------------------------
  # Android application build and tests
  # ------------------------------------------------------------
  android:
    name: Android Build & Test
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}
          cache: gradle

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK components
        run: |
          sdkmanager "platform-tools
